<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- The analyzer and generator suites build a throwaway CSharpCompilation per case and
         run the real Roslyn component over it. That is the whole harness: no analyzer-testing
         package, so nothing has to agree with it about reference assemblies, and the version
         is already the one the analyzer is pinned to. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- There is deliberately no xunit.runner.json: cross-collection parallelism is on, which is
       xUnit's default. The three process-wide registries are handled by putting every class that
       touches one in a single collection instead — see RegistryCollection. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\Versionable\Versionable.csproj" />
    <!-- Referenced both ways: as an analyzer, so generated code is exercised in the test
         compilation, and as a plain assembly, so 2b can unit-test the analyzer types. -->
    <ProjectReference Include="..\..\src\Versionable.Analyzers\Versionable.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
