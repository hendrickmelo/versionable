{
  "config": {
    "line-length": { "line_length": 120 },
    "no-duplicate-heading": false,
    "no-inline-html": false,
    "table-column-style": false
  },
  "ignores": [
    // AGENTS.md is excluded because part of it is pasted verbatim by an external
    // sync script and compared byte-for-byte; it cannot be reflowed to fit MD013.
    "AGENTS.md",
    ".*/**",
    "docs/_build/**",
    "docs/plans/**",
    "node_modules/**"
  ]
}
