{
  "config": {
    "line-length": { "line_length": 120 },
    "no-duplicate-heading": false,
    "no-inline-html": false,
    "table-column-style": false
  },
  "ignores": [
    ".*/**",
    "docs/_build/**",
    "docs/plans/**",
    "node_modules/**",
    // Not Markdown: the Roslyn release tracker parses these itself (RS2007).
    "dotnet/src/Versionable.Analyzers/AnalyzerReleases.*.md"
  ]
}
